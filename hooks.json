{
  "whip-it": {
    "PreToolUse": [
      {
        "matcher": "invoke_subagent|define_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "\"./bin/launch.cmd\" --client antigravity --event PreToolUse"
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "\"./bin/launch.cmd\" --client antigravity --event PreInvocation"
      }
    ]
  }
}
