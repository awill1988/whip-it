{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "spawn_agent|subagent|agent",
        "hooks": [
          {
            "type": "command",
            "command": "whip-it --client codex --event PreToolUse"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "whip-it --client codex --event UserPromptSubmit"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "whip-it --client codex --event Stop"
          }
        ]
      }
    ]
  }
}
